@model MedicalAppointmentWebApp.Models.ViewModels.DoctorPractices
@{
    ViewData["Title"] = "Ιατρεία";
    Layout = "_Layout";
}
<!---GOOGLE MAPS API ----->
<script async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAsMPBVJ_u5YLmRIrIti_U0YRp3UhOi8-Q&callback=console.debug&libraries=maps,marker&v=beta">
</script>
<!-------------->



<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Τα ιατρεία μου</h1>
        <p class="subtitle mb-5"></p>


        <form method="get" asp-controller="Practice" asp-action="Enroll">
            <button class="btn primary-btn d-flex justify-content-center align-items-center mx-auto">
                Προσθήκη ιατρείου
            </button>
        </form>


        <ul class="admin-registrations-list list-unstyled mx-auto mt-5">

            @foreach (var practice in Model.Practices)
            {
                <li class="mb-3">
                    <div class="row">

                        <div class="col-8 fc-blue fs-18 fw-600 text-start">#@practice.Id.ToString().Substring(0, Math.Min(6, practice.Id.ToString().Length))</div>
                        <div class="col-4 d-flex justify-content-end"><div class="status-circle"></div></div>

                    </div>
                    <div class="row mt-3 mb-3">
                        <div class="col-12 fw-100 fc-black fs-16 text-start">@practice.PlaceId</div>

                        <gmp-map style="height:300px;" center="@practice.Lon.ToString(System.Globalization.CultureInfo.InvariantCulture),@practice.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)" zoom="15" map-id="@practice.Id">
                            <gmp-advanced-marker position="@practice.Lon.ToString(System.Globalization.CultureInfo.InvariantCulture),@practice.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture)" title=""></gmp-advanced-marker>
                        </gmp-map>

                    </div>
                    <div class="row">
                        <div class="col-5 fs-16 fw-100 fc-grey text-start">
                            @(practice.MondayStart?.ToString(@"hh\:mm") ?? "--:--")
                            -
                            @(practice.MondayEnd?.ToString(@"hh\:mm") ?? "--:--")
                        </div>
                     

                    </div>
                    <div class="row">
                        <div class="col-5 fs-16 fw-100 fc-grey text-start">@practice.RegistrationStatus.ToString()</div>
                    </div>
                </li>

            }


        </ul>
    </div>
</div>
