@using System.Reflection
@using MedicalAppointmentWebApp.Models.ViewModels
@model MedicalAppointmentWebApp.Models.ViewModels.DoctorSearchViewModel

@{
    ViewBag.Title = "Ιατροί";
    Layout = "_Layout";
}

<form method="get" action="@Url.Action(action: "Search", controller: "Doctor")" class="mx-auto mb-5 search-form">

    <div class="position-relative mb-1">
        <svg class="position-absolute top-50 start-0 translate-middle-y ms-3" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#757575" fill-rule="evenodd" clip-rule="evenodd" d="M6.75 8.25V6V4.5H8.25H9.75V6L8.25 6L8.25 8.25C8.25 10.3211 9.92893 12 12 12C14.0711 12 15.75 10.3211 15.75 8.25V6H14.25V4.5H15.75H17.25V6V8.25C17.25 10.8949 15.2942 13.0829 12.75 13.4468V16.5C12.75 17.7426 13.7574 18.75 15 18.75C16.0376 18.75 16.9112 18.0476 17.1712 17.0924C16.3387 16.7624 15.75 15.95 15.75 15C15.75 13.7574 16.7574 12.75 18 12.75C19.2426 12.75 20.25 13.7574 20.25 15C20.25 15.9999 19.5978 16.8475 18.6955 17.1404C18.3916 18.9064 16.8527 20.25 15 20.25C12.9289 20.25 11.25 18.5711 11.25 16.5V13.4468C8.70578 13.0829 6.75 10.8949 6.75 8.25ZM18.75 15C18.75 15.4142 18.4142 15.75 18 15.75C17.5858 15.75 17.25 15.4142 17.25 15C17.25 14.5858 17.5858 14.25 18 14.25C18.4142 14.25 18.75 14.5858 18.75 15Z" />
        </svg>

        <input type="text" asp-for="Term" aria-label="Όνομα Ιατρού ή Ειδικότητα" placeholder="Όνομα Ιατρού ή Ειδικότητα" class="form-control search-input ps-5" />
    </div>

    <div class="position-relative mt-1">
      <div class="address-autocomplete" id="address-autocomplete">
                    <div class="input-wrap">
                        <div class="pin-icon" aria-hidden="true">
                            <svg class="position-absolute top-50 start-0 translate-middle-y ms-3" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="pointer-events: none;">
                                <path fill="#757575" fill-rule="evenodd" clip-rule="evenodd" d="M12 21.75L11.3 21.05C7.5 17.25 4 13.8 4 10.2C4 5.67 7.58 2 12 2C16.42 2 20 5.67 20 10.2C20 13.8 16.5 17.25 12.7 21.05L12 21.75ZM12 4C8.69 4 6 6.78 6 10.2C6 13.1 9 16.15 12 19.25C15 16.15 18 13.1 18 10.2C18 6.78 15.31 4 12 4ZM12 13C13.66 13 15 11.66 15 10C15 8.34 13.66 7 12 7C10.34 7 9 8.34 9 10C9 11.66 10.34 13 12 13ZM12 11C12.55 11 13 10.55 13 10C13 9.45 12.55 9 12 9C11.45 9 11 9.45 11 10C11 10.55 11.45 11 12 11Z" />
                            </svg>
                        </div>
                        <input id="practiceAddress"
                               type="text"
                               placeholder="Τοποθεσία"
                               autocomplete="off" />
                    </div>

                    <div id="practiceSuggestions" class="suggestions" hidden></div>
                </div>


        <input type="hidden" asp-for="FullAddress" id="FullAddress" />
        <input type="hidden" asp-for="Lat" id="Lat" />
        <input type="hidden" asp-for="Lon" id="Lon" />
    </div>
    <button type="submit" class="btn primary-btn btn-primary w-100 mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20 L16.5 16.5"></path>
        </svg>
        Αναζήτηση
    </button>

    
        <div class="mt-2">
    <select asp-for="SortBy" class="form-select" onchange="this.form.submit()">
        <option value="">Ταξινόμηση</option>
        <option value="name_asc">Όνομα Α-Ω</option>
        <option value="name_desc">Όνομα Ω-Α</option>
        <option value="specialty_asc">Ειδικότητα Α-Ω</option>
        <option value="specialty_desc">Ειδικότητα Ω-Α</option>
    </select>
</div>



</form>


<div class="wrapper d-flex">
    <div class="mx-auto w-100">


        <h1 class="title mb-2">Αποτελέσματα Αναζήτησης</h1>
        <p class="subtitle mb-5"></p>






<ul class="doctor-result-list list-unstyled mx-auto">
@foreach (var item in Model.Doctors)
{
    var doctor = item.Doctor;

    <li class="doctor-profile mb-3"
        onclick="location.href='@Url.Action("Profile","Doctor", new { doctor_id = doctor.Id })'">

        <div class="row">
            <div class="col-3">
                @if (doctor?.ImageUrl is null)
                {
                    <img class="rounded-circle object-fit-cover doctor-image"
                         style="width:64px; height:64px;"
                         src="https://media.istockphoto.com/id/1327592506/vector/default-avatar-photo-placeholder-icon-grey-profile-picture-business-man.jpg"
                         alt="Profile">
                }
                else
                {
                    <img class="rounded-circle object-fit-cover doctor-image"
                         style="width:64px; height:64px;"
                         src="/Images/@doctor.ImageUrl" />
                }
            </div>

            <div class="col-9 text-start">
                <p class="fc-black fs-16 fw-400 mb-0">@doctor.FirstName @doctor.LastName</p>
                <p class="fc-grey fs-16 fw-100">@Model.GetDisplayName(doctor)</p>

                @if (item.FirstAvailableSlot.HasValue)
                {
                    <p>Πρώτο διαθέσιμο ραντεβού:
                        @item.FirstAvailableSlot.Value.ToString("dd/MM/yyyy HH:mm")
                    </p>
                }
                else
                {
                    <p>Δεν υπάρχει διαθέσιμο ραντεβού</p>
                }
            </div>
        </div>

    </li>
}
</ul>


        <div aria-label="Page navigation">
            <ul class="pagination mx-auto mt-5 d-flex justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term,
                                lon = Model.Lon,
                                lat = Model.Lat,
                                fullAddress = Model.FullAddress,
                                currentPage = Model.CurrentPage - 1,
                                pageSize = Model.PageSize})" 
                                    class="page-link border-0 fc-black bg-transparent">🡠</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term, 
                                lat = Model.Lat, 
                                lon = Model.Lon, 
                                fullAddress = Model.FullAddress,
                                currentPage = i, 
                                pageSize = Model.PageSize })" 
                                    class="page-link border-0 @(i == Model.CurrentPage ? "active bg-blue" : "fc-black bg-transparent")">
                            @i
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term,
                                lon = Model.Lon,
                                lat = Model.Lat,
                                fullAddress = Model.FullAddress,
                                currentPage = Model.CurrentPage + 1, 
                                pageSize = Model.PageSize })" 
                                    class="page-link border-0 fc-black bg-transparent">🡢</a>
                    </li>
                }
            </ul>
        </div>


    </div>
</div>
