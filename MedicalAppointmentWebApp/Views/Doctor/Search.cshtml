@using System.Reflection
@using MedicalAppointmentWebApp.Models.ViewModels
@model MedicalAppointmentWebApp.Models.ViewModels.DoctorSearchViewModel

@{
    ViewBag.Title = "Ιατροί";
    Layout = "_Layout";
} 

        <form method="get" id="searchForm"  asp-controller="Doctor" asp-action="Search" class="mx-auto mb-5 search-form">

    <div class="position-relative mb-1">
        <svg class="position-absolute top-50 start-0 translate-middle-y ms-3" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#757575" fill-rule="evenodd" clip-rule="evenodd" d="M6.75 8.25V6V4.5H8.25H9.75V6L8.25 6L8.25 8.25C8.25 10.3211 9.92893 12 12 12C14.0711 12 15.75 10.3211 15.75 8.25V6H14.25V4.5H15.75H17.25V6V8.25C17.25 10.8949 15.2942 13.0829 12.75 13.4468V16.5C12.75 17.7426 13.7574 18.75 15 18.75C16.0376 18.75 16.9112 18.0476 17.1712 17.0924C16.3387 16.7624 15.75 15.95 15.75 15C15.75 13.7574 16.7574 12.75 18 12.75C19.2426 12.75 20.25 13.7574 20.25 15C20.25 15.9999 19.5978 16.8475 18.6955 17.1404C18.3916 18.9064 16.8527 20.25 15 20.25C12.9289 20.25 11.25 18.5711 11.25 16.5V13.4468C8.70578 13.0829 6.75 10.8949 6.75 8.25ZM18.75 15C18.75 15.4142 18.4142 15.75 18 15.75C17.5858 15.75 17.25 15.4142 17.25 15C17.25 14.5858 17.5858 14.25 18 14.25C18.4142 14.25 18.75 14.5858 18.75 15Z" />
        </svg>

        <input type="text" asp-for="Term" aria-label="Όνομα Ιατρού ή Ειδικότητα" placeholder="Όνομα Ιατρού ή Ειδικότητα" class="form-control search-input ps-5" />
    </div>

    <div class="position-relative mt-1">
      <div class="address-autocomplete" id="address-autocomplete">
                    <div class="input-wrap">
                        <div class="pin-icon" aria-hidden="true">
                            <svg class="position-absolute top-50 start-0 translate-middle-y ms-3" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="pointer-events: none;">
                                <path fill="#757575" fill-rule="evenodd" clip-rule="evenodd" d="M12 21.75L11.3 21.05C7.5 17.25 4 13.8 4 10.2C4 5.67 7.58 2 12 2C16.42 2 20 5.67 20 10.2C20 13.8 16.5 17.25 12.7 21.05L12 21.75ZM12 4C8.69 4 6 6.78 6 10.2C6 13.1 9 16.15 12 19.25C15 16.15 18 13.1 18 10.2C18 6.78 15.31 4 12 4ZM12 13C13.66 13 15 11.66 15 10C15 8.34 13.66 7 12 7C10.34 7 9 8.34 9 10C9 11.66 10.34 13 12 13ZM12 11C12.55 11 13 10.55 13 10C13 9.45 12.55 9 12 9C11.45 9 11 9.45 11 10C11 10.55 11.45 11 12 11Z" />
                            </svg>
                        </div>
                        <input id="practiceAddress"
                               type="text"
                               placeholder="Τοποθεσία"
                               autocomplete="off" 
                               asp-for="FullAddress"/>
                    </div>

                    <div id="practiceSuggestions" class="suggestions" hidden></div>
                </div>



        <input type="hidden" asp-for="Lat" id="Lat" />
        <input type="hidden" asp-for="Lon" id="Lon" />
    </div>
    <button type="submit" class="btn primary-btn btn-primary w-100 mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20 L16.5 16.5"></path>
        </svg>
        Αναζήτηση
    </button>


</form>


<div class="wrapper d-flex">
    <div class="mx-auto w-100">


        <h1 class="title mb-2">Αποτελέσματα Αναζήτησης</h1>
      



        <div class="d-flex mx-auto gap-2 mt-4 mb-5" style="max-width: 420px;">
              
                  <button class="filters-toggler"><svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="style=stroke">
<g id="filter-circle">
<path id="vector (Stroke)" fill-rule="evenodd" clip-rule="evenodd" d="M7.75 17.5C7.75 17.0858 7.41421 16.75 7 16.75H2C1.58579 16.75 1.25 17.0858 1.25 17.5C1.25 17.9142 1.58579 18.25 2 18.25H7C7.41421 18.25 7.75 17.9142 7.75 17.5Z" fill="currentColor"/>
<path id="vector (Stroke)_2" fill-rule="evenodd" clip-rule="evenodd" d="M16.25 6.5C16.25 6.08579 16.5858 5.75 17 5.75H22C22.4142 5.75 22.75 6.08579 22.75 6.5C22.75 6.91421 22.4142 7.25 22 7.25H17C16.5858 7.25 16.25 6.91421 16.25 6.5Z" fill="currentColor"/>
<path id="vector (Stroke)_3" fill-rule="evenodd" clip-rule="evenodd" d="M22.75 17.5C22.75 17.0858 22.4142 16.75 22 16.75H13C12.5858 16.75 12.25 17.0858 12.25 17.5C12.25 17.9142 12.5858 18.25 13 18.25H22C22.4142 18.25 22.75 17.9142 22.75 17.5Z" fill="currentColor"/>
<path id="vector (Stroke)_4" fill-rule="evenodd" clip-rule="evenodd" d="M1.25 6.5C1.25 6.08579 1.58579 5.75 2 5.75H11C11.4142 5.75 11.75 6.08579 11.75 6.5C11.75 6.91421 11.4142 7.25 11 7.25H2C1.58579 7.25 1.25 6.91421 1.25 6.5Z" fill="currentColor"/>
<path id="vector (Stroke)_5" fill-rule="evenodd" clip-rule="evenodd" d="M10 15.1499C11.2426 15.1499 12.25 16.1573 12.25 17.3999C12.25 18.6425 11.2426 19.6499 10 19.6499C8.75736 19.6499 7.75 18.6425 7.75 17.3999C7.75 16.1573 8.75736 15.1499 10 15.1499ZM13.75 17.3999C13.75 15.3288 12.0711 13.6499 10 13.6499C7.92893 13.6499 6.25 15.3288 6.25 17.3999C6.25 19.471 7.92893 21.1499 10 21.1499C12.0711 21.1499 13.75 19.471 13.75 17.3999Z" fill="currentColor"/>
<path id="vector (Stroke)_6" fill-rule="evenodd" clip-rule="evenodd" d="M14 4.1499C12.7574 4.1499 11.75 5.15726 11.75 6.3999C11.75 7.64254 12.7574 8.6499 14 8.6499C15.2426 8.6499 16.25 7.64254 16.25 6.3999C16.25 5.15726 15.2426 4.1499 14 4.1499ZM10.25 6.3999C10.25 4.32883 11.9289 2.6499 14 2.6499C16.0711 2.6499 17.75 4.32883 17.75 6.3999C17.75 8.47097 16.0711 10.1499 14 10.1499C11.9289 10.1499 10.25 8.47097 10.25 6.3999Z" fill="currentColor"/>
</g>
</g>
</svg></button>

<div class="filters-overlay"></div>

                  

    <select asp-for="SortBy" form="searchForm" class="form-select sort" onchange="this.form.submit()">
        <option value="">Ταξινόμηση</option>
        <option value="name_asc">Όνομα Α-Ω</option>
        <option value="name_desc">Όνομα Ω-Α</option>
        <option value="specialty_asc">Ειδικότητα Α-Ω</option>
        <option value="specialty_desc">Ειδικότητα Ω-Α</option>
        <option value="first_available">Πρώτο διαθέσιμο ραντεβού</option>
    </select>
</div>

<div class="filters-overlay"></div>

<div class="filters-panel">
    <h2 class="text-start  fc-black fs-18">Φίλτρα</h2>

    <div class="registration-separator"></div>
    <div class="filter-item mt-5">
        <h3 class="text-start fc-black fs-16">Φύλο</h3>
          <div class="d-flex gap-3 mt-3">
                    <div class="form-check">
                        <input asp-for="Gender" form="searchForm" class="form-check-input"
                               type="radio"
                               value="1"
                               id="genderMalePatient"
                               />

                        <label class="form-check-label" for="genderMalePatient">
                            Άντρας
                        </label>
                    </div>

                    <div class="form-check">
                        <input asp-for="Gender" form="searchForm" class="form-check-input"
                               type="radio"
                               value="2"
                               id="genderFemalePatient"/>

                        <label class="form-check-label" for="genderFemalePatient">
                            Γυναίκα
                        </label>
                    </div>
                </div>
                 </div>
                <div class="filter-item mt-5">
                 <h3 class="text-start fc-black fs-16 ">Ακτίνα αναζήτησης</h3>
                  <div class="text-start mt-3">
       <input asp-for="AreaDistance" value="@(Model.AreaDistance ?? 10)" form="searchForm" id="radius"
       type="range"
       min="1"
       max="50"
       step="1"
       oninput="radiusValue.innerText = this.value" />
       </div>
            <div class="text-start mt-2">
<span class="fc-black fs-14 " id="radiusValue"> @(Model.AreaDistance ?? 10)</span><span class="fc-black fs-14 fw-200"> χλμ</span>
</div>
    </div>

    <button form="searchForm" class=" mt-5 w-100 btn primary-btn">Εφαρμογή</button>
</div>



<ul class="doctor-result-list list-unstyled mx-auto">
@foreach (var item in Model.Doctors)
{
    var doctor = item.Doctor;

    <li class="doctor-profile mb-3"
        onclick="location.href='@Url.Action("Profile","Doctor", new { doctor_id = doctor.Id })'">

        <div class="row">
            <div class="col-3">
                @if (doctor?.ImageUrl is null)
                {
                    <img class="rounded-circle object-fit-cover doctor-image"
                         style="width:64px; height:64px;"
                         src="/Images/placeholder-doctor-image.png"
                         alt="Profile">
                }
                else
                {
                    <img class="rounded-circle object-fit-cover doctor-image"
                         style="width:64px; height:64px;"
                         src="/Images/@doctor.ImageUrl" />
                }
            </div>

            <div class="col-9 text-start">
                <p class="fc-black fs-16 fw-400 mb-0">@doctor.FirstName @doctor.LastName</p>
                <p class="fc-grey fs-16 fw-100">@Model.GetDisplayName(doctor)</p>

                @if (item.FirstAvailableSlot.HasValue)
                {
                    <p class="fs-14 fc-black fw-100 mb-1">Πρώτο διαθέσιμο ραντεβού: </p>
                        <p class="fs-14 fc-blue fw-400">
                        @item.FirstAvailableSlot.Value.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p class="fs-14 fc-black fw-100 mb-1">Διεύθυνση: </p>
                        <p class="fs-14 fc-blue fw-400">
                        @item.Practice.FullAddress
                    </p>
                }
               

            </div>
        </div>

    </li>
}
</ul>


        <div aria-label="Page navigation">
            <ul class="pagination mx-auto mt-5 d-flex justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term,
                                lon = Model.Lon,
                                lat = Model.Lat,
                                gender = Model.Gender,
                                AreaDistance = Model.AreaDistance,
                                fullAddress = Model.FullAddress,
                                currentPage = Model.CurrentPage - 1,
                                pageSize = Model.PageSize})" 
                                    class="page-link border-0 fc-black bg-transparent">🡠</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term, 
                                lat = Model.Lat, 
                                lon = Model.Lon,
                                gender = Model.Gender,
                                areaDistance = Model.AreaDistance,
                                fullAddress = Model.FullAddress,
                                sortBy = Model.SortBy,
                                currentPage = i, 
                                pageSize = Model.PageSize })" 
                                    class="page-link border-0 @(i == Model.CurrentPage ? "active bg-blue" : "fc-black bg-transparent")">
                            @i
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Search", controller: "Doctor", new { 
                                term = Model.Term,
                                lon = Model.Lon,
                                lat = Model.Lat,
                                gender = Model.Gender,
                                sortBy = Model.SortBy,
                                areaDistance = Model.AreaDistance,
                                fullAddress = Model.FullAddress,
                                currentPage = Model.CurrentPage + 1, 
                                pageSize = Model.PageSize })" 
                                    class="page-link border-0 fc-black bg-transparent">🡢</a>
                    </li>
                }
            </ul>
        </div>


    </div>
</div>
