@model MedicalAppointmentWebApp.Models.ViewModels.EditDoctorProfileViewModel
@{
    ViewData["Title"] = "Επεξεργασία Προφίλ";
    Layout = "_Layout";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
      
      
        <form asp-controller="Doctor" asp-action="EditProfile" method="post" class="register-form" enctype="multipart/form-data" autocomplete="off">
            <div class="my-1">
                <div class="container mt-4 text-center">
                    <div class="image-wrapper">
                        @if (Model.Doctor?.ImageUrl is null)
                        {
                            <img id="previewImage"
                                 src="https://media.istockphoto.com/id/1327592506/vector/default-avatar-photo-placeholder-icon-grey-profile-picture-business-man.jpg?s=612x612&w=0&k=20&c=BpR0FVaEa5F24GIw7K8nMWiiGmbb8qmhfkpXcp1dhQg="
                                 alt="Profile">
                        }
                        else 
                        {
                            <img id="previewImage" src="/Images/@Model.Doctor.ImageUrl" alt="Profile">
                        }

                        <div class="overlay">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="40"
                                 height="40"
                                 fill="white"
                                 viewBox="0 0 16 16">
                                <path d="M10.5 8.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0" />
                                <path d="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4zm.5 2a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m9 2.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0" />
                            </svg>
                        </div>
                    </div>
        
                    <input asp-for="Image" type="file" id="imageInput" accept="image/*" hidden>
                </div>
            </div>
          
            <h1 class="title mt-4 mb-2 fc-blue">@Model.Doctor?.FirstName @Model.Doctor?.LastName</h1>
            <p class="subtitle">@Html.DisplayFor(m => m.Doctor!.Specialty)</p>

          <div class="mt-5 registration-separator"></div>

            <div class="mt-4 text-start d-flex gap-2">
                <p class="form-label edit-profile-label ">ΑΜΚΑ:</p>
            <p class="fc-black fs-16 fw-100 ">@Model.Doctor.Amka</p>
            </div>

            <div class="mt-2 text-start d-flex gap-2">
                <p class="form-label edit-profile-label">Αριθμός Αδείας:</p>
                <p class="fc-black fs-16 fw-100 ">@Model.Doctor.LicenseNumber</p>
            </div>

            <div class="mt-2 mb-3 text-start d-flex gap-2">
                <p class="form-label edit-profile-label">Ημ. Γέννησης:</p>
                <p class="fc-black fs-16 fw-100 ">
                    @Model.Doctor?.BirthDate?.ToString("dd MMMM yyyy")
                </p>
            </div>



            <div class=" registration-separator"></div>
           

            <div class="mt-5 doctor-bio-edit">
                <label class="form-label edit-profile-label">Σύντομο Βιογραφικό</label>
                <textarea asp-for="Bio"
                          id="bioInput"
                          class="form-control mb-2"
                          rows="1"
                          maxlength="499"></textarea>
            </div>

            <div class="mt-5 registration-separator"></div>


            <div class="mb-3 mt-5">
                <label class="form-label edit-profile-label">Κινητό Τηλέφωνο:</label>
                    <p class="label-description mt-0">
                        Θα παραμείνει κρυφό. Χρησιμοποιείται μόνο για τον λογαριασμό σας
                    </p>
                <input asp-for="Phone"
                       type="tel"
                       class="form-control register-input editable-field"
                       
                       inputmode="tel"
                       pattern="[0-9]{10}"
                       minlength="10"
                       maxlength="10"
                       title="Το τηλέφωνο απαιτείται να έχει 10 ψηφία"
                       required />



            </div>

           

            <div class="mt-4">
                <label class="form-label edit-profile-label">Email:</label>


                <input asp-for="Email"
                       type="email"
                       class="form-control register-input editable-field"
                       
                       maxlength="254"
                       required />


            </div>

            <div class="mt-4">
                <label class="form-label edit-profile-label">Κωδικός:</label>
                <p class="label-description mt-0">
                    Συμπληρώστε αυτό το πεδίο μόνο εάν θέλετε να αλλάξετε τον κωδικό πρόσβασής σας
                </p>

                <div class="password-wrapper">
                    <input asp-for="Password"
                           type="password"
                           class="form-control register-input editable-field"
                            
                            />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">
                        <svg class="eye-icon eye-open"
                             width="18"
                             height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor"
                                  stroke-width="2" />
                            <circle cx="12"
                                    cy="12"
                                    r="3"
                                    stroke="currentColor"
                                    stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18"
                             height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor"
                                  stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor"
                                  stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor"
                                  stroke-width="2" />
                        </svg>
                    </button>
                </div>
            </div>



           
                <button type="submit" class="w-100 mx-auto mt-3 btn mb-5 primary-btn">Αποθήκευση</button>
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="mt-4 alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="mt-4 alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
        </form>
    </div>
</div>