            Days = new[]
            {
                new { Date = new DateTime(2026, 2, 10), DayName = "Τρίτη",    Slots = new[] { "18:00", "18:30" } },
                new { Date = new DateTime(2026, 2, 11), DayName = "Τετάρτη",  Slots = new[] { "19:00" } },
                new { Date = new DateTime(2026, 2, 12), DayName = "Πέμπτη",   Slots = Array.Empty<string>() },
                new { Date = new DateTime(2026, 2, 13), DayName = "Παρασκευή",Slots = new[] { "12:00","12:30" } },
                new { Date = new DateTime(2026, 2, 14), DayName = "Σάββατο",  Slots = new[] { "10:00" } },
                new { Date = new DateTime(2026, 2, 15), DayName = "Κυριακή",  Slots = Array.Empty<string>() },
                new { Date = new DateTime(2026, 2, 16), DayName = "Δευτέρα",  Slots = Array.Empty<string>() },
            }
        },

        new {
            OfficeId = 3,
            OfficeName = "Αχαρνές",
            OfficeAddress = "Φιλής 33, Αχαρνές",
            Days = new[]
            {
                new { Date = new DateTime(2026, 2, 10), DayName = "Τρίτη",    Slots = new[] { "18:00", "18:30" } },
                new { Date = new DateTime(2026, 2, 11), DayName = "Τετάρτη",  Slots = new[] { "19:00" } },
                new { Date = new DateTime(2026, 2, 12), DayName = "Πέμπτη",   Slots = Array.Empty<string>() },
