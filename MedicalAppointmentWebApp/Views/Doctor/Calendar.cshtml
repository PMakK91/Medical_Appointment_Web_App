@model Doctor

@{
    ViewData["Title"] = "Ημερολόγιο";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Ημερολόγιο</h1>
        <p class="subtitle mb-5"></p>

        <div class="office-tabs mt-5">
           

            @{
                bool first = true;
            }
            @foreach (var practice in Model.Practices)
            {
                <button type="button"
                        class="office-tab @(first ? "active" : "")"
                        data-office-id="@practice.Id"
                        onclick="showOffice('@practice.Id')">
                    @practice.Name
                </button>
                first = false;
            }

        </div>

        @foreach (var office in Model.Practices)
        {
            <div class="office-panel"
                 id="office-@office.Id"
                 style="display:@(office.Equals(Model.Practices.First()) ? "block" : "none")">

                <section class="calendarContainer" data-office-id="@office.Id">
                    <div class="horizontal-nav">
                        <div class="calendar-heading"></div>
                        <div class="nav-buttons-container"></div>
                    </div>

                    <div class="calendarInnerContainer"></div>
                </section>
            </div>
        }

    </div>
</div>

