@{
    ViewData["Title"] = "Ημερολόγιο";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Ημερολόγιο</h1>
        <p class="subtitle mb-5"></p>

        <div class="office-tabs mt-5">
           

            @for (int i = 0; i < offices.Length; i++)
            {
                var o = offices[i];
                <button type="button"
                        class="office-tab @(i == 0 ? "active" : "")"
                        data-office-id="@o.OfficeId"
                        onclick="showOffice(@o.OfficeId)">
                    @o.OfficeName
                </button>
            }


        </div>


        @foreach (var office in offices)
        {
            <div class="office-panel"
                 id="office-@office.OfficeId"
                 style="display:@(office.Equals(offices[0]) ? "block" : "none")">

                <section class="calendarContainer" data-office-id="@office.OfficeId">
                    <div class="horizontal-nav">
                        <div class="calendar-heading">
                        </div>
                        <div class="nav-buttons-container"></div>
                    </div>

                    <div class="calendarInnerContainer"></div>
                </section>
            </div>
        }


    </div>
</div>

