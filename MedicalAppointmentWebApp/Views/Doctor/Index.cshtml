@using System.Reflection
@model MedicalAppointmentWebApp.Models.ViewModels.DoctorSearchViewModel

@{
    ViewBag.Title = "Ιατροί";
    Layout = "_Layout";
}



<form method="get" action="@Url.Action(action: "Index", controller: "Doctor")" class="mx-auto mb-5 search-form">

    <input type="text" name="term" value="@Model.Term" aria-label="Αναζήτηση" class="form-control search-input " />


    <button type="submit" class="btn primary-btn btn-primary w-100 mt-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20 L16.5 16.5"></path>
        </svg>
        Αναζήτηση
    </button>

</form>


<div class="wrapper d-flex">
    <div class="mx-auto w-100">
       
        
        <h1 class="title mb-2">Αποτελέσματα Αναζήτησης</h1>
        <p class="subtitle mb-5">Πληκτρολογίστε όνομα ιατρού ή ειδικότητα</p>
        <ul class="doctor-result-list list-unstyled mx-auto">
            @foreach (var doctor in Model.Doctors)
            {

                <li class="doctor-profile mb-3" onclick="location.href = '@Url.Action(action: "Profile", controller: "Doctor", new { doctor_id = doctor.Id })'">

                    <div class="row">
                        <div class="col-3">
                            <img class="rounded-circle object-fit-cover doctor-image" style="width:64px; height:64px;" src="/img/doctros/profile-photos/@doctor.ImageUrl" />
                        </div>
                        <div class="col-9 text-start">
                            <p class="fc-black fs-16 fw-400 mb-0">@doctor.FirstName @doctor.LastName</p>
                            <p class="fc-grey fs-16 fw-100">@Model.GetDisplayName(doctor)</p>
                        </div>
                    </div>




                </li>

            }


        </ul>


        <div aria-label="Page navigation">
            <ul class="pagination mx-auto mt-5 d-flex justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a href="@Url.Action(action: "Index", controller: "Doctor", new { term = Model.Term, page = Model.CurrentPage - 1, pageSize = Model.PageSize })" class="page-link border-0 fc-black bg-transparent">🡠</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Index", controller: "Doctor", new { term = Model.Term, page = i, pageSize = Model.PageSize })" class="page-link border-0 @(i == Model.CurrentPage ? "active bg-blue" : "fc-black bg-transparent")">
                            @i
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "Index", controller: "Doctor", new { term = Model.Term, page = Model.CurrentPage + 1, pageSize = Model.PageSize })" class="page-link border-0 fc-black bg-transparent">🡢</a>
                    </li>
                }
            </ul>
        </div>


</div>
</div>
