@model IEnumerable<Doctor>

<style type="text/css">
    .doctor-profile:hover {
     cursor:pointer;
    }
</style>

<h2>Doctors</h2>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Specialty</th>
        </tr>
    </thead>
    <tbody>
        @{
            var index = 1;
        }
        @foreach (var doctor in Model)
        {
            <tr class="doctor-profile"
                onclick ="location.href = '@Url.Action(action: "Profile",controller:"Doctor", new { doctor_id = doctor.Id })'">
                <td>@doctor.FirstName</td>
                <td>@doctor.LastName</td>
                <td>@doctor.Specialty.ToString()</td>
            </tr>

            ++index;
        }
    </tbody>
</table>
