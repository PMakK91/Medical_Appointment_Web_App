@using MedicalAppointmentWebApp.Data.Enums
@model Doctor

@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <img class="doctor-profile-img" src="" alt=""/>
        <h1 class="title mb-2">@Model.FirstName @Model.LastName</h1>
        <p class="subtitle mb-5">@Html.DisplayFor(m => m.Specialty)</p>
        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="fc-black fs-16 fw-100">@Model.Bio</p>
        }

    @if (Model.Practices != null && Model.Practices.Any())
    {
        <div class="office-tabs mt-5">
            @{
                bool firstTab = true;
            }
            @foreach (var practice in Model.Practices)
            {
                @if (practice.RegistrationStatus.Equals(RegistrationFormStatus.Accepted))
                {
                    <button type="button"
                            class="office-tab @(firstTab ? "active" : "")"
                            data-office-id="@practice.Id"
                            onclick="showOffice('@practice.Id')">
                        @practice.Name
                    </button>
        
                    firstTab = false;
                }
            }
        </div>

        {
            firstTab = true;
        }

        @foreach (var practice in Model.Practices)
        {
            @if (practice.RegistrationStatus.Equals(RegistrationFormStatus.Accepted))
            {
                <div class="office-panel"
                     id="office-@practice.Id"
                     style="display:@(practice.Equals(Model.Practices.First()) ? "block" : "none")">

                        <div class="schedule-wrap d-flex justify-content-center mt-3">

                    </div>
                </div>
                
                firstTab = false;
            }
        }
    }
    </div>
</div>

<script>
    $(document).ready(function () {

        function loadOffice(practiceId) {
            var officePanel = $("#office-" + practiceId);
            var scheduleWrap = officePanel.find(".schedule-wrap");

            if (officePanel.data("loaded")) return;

            scheduleWrap.load('@Url.Action("AvailableTimeSlots", "Practice")?Id=' + practiceId, function () {
                officePanel.data("loaded", true);
            });
        }

        var firstVisibleOffice = $(".office-panel:visible").first();
        if (firstVisibleOffice.length) {
            var firstId = firstVisibleOffice.attr("id").replace("office-", "");
            loadOffice(firstId);
        }

        const observer = new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
                if (mutation.attributeName === "style") {
                    var element = $(mutation.target);

                    if (element.is(":visible")) {
                        var practiceId = element.attr("id").replace("office-", "");
                        loadOffice(practiceId);
                    }
                }
            });
        });

        $(".office-panel").each(function () {
            observer.observe(this, { attributes: true });
        });

    });
</script>
