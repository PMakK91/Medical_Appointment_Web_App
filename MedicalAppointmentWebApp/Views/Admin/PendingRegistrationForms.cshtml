@model IEnumerable<Doctor>
@{
}

<h2>Pending Registration Forms</h2>

<table class="table">
    <thead>
        <tr>
            <th>#</th>
            <th>Email</th>
            <th>Amka</th>
            <th>Specialty</th>
            <th>Name</th>
            <th>Last Name</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @{
        var index = 1;
    }
    @foreach (var form in Model)
    {
        <tr>
            <td>@index</td>
            <td>@form.Email</td>
            <td>@form.Amka</td>
            <td>@form.Specialty.ToString()</td>
            <td>@form.FirstName</td>
            <td>@form.LastName</td>
            <td><a class="link-underline-success" asp-controller="Admin" asp-action="AcceptRegistration" asp-route-id="@form.Id">Accept</a></td>
            <td><a class="link-underline-danger" asp-controller="Admin" asp-action="RejectRegistration" asp-route-id="@form.Id">Reject</a></td>
        </tr>

        ++index;
    }
    </tbody>
</table>
