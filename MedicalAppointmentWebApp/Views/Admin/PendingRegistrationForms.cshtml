@model MedicalAppointmentWebApp.Models.ViewModels.DoctorSearchViewModel
@{    
    ViewData["Title"] = "Pending Doctor Registrations";
    Layout = "_LayoutNoNavBar";
}

<!---
<h2>Pending Registration Forms</h2>

<!-- Search Form -->
<nav class="navbar navbar-light bg-light">
    <form method="get" action="@Url.Action(action: "PendingRegistrationForms", controller: "Admin")" class="form-inline">
        <input type="text" name="term" value="@Model.Term" placeholder="Search" class="form-control col-xs-1" />
        <button type="submit" class="btn btn-outline-primary col-xs-2">Search</button>
    </form>
</nav>


<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Εκκρεμείς Αιτήσεις</h1>
        <p class="subtitle mb-5">Αιτήσεις ιατρών προς εξέταση</p>




        <ul class="admin-registrations-list list-unstyled">
             
            @foreach (var doctor in Model.Doctors)
            {
            <li>
                <span class="registration-id">@doctor.Id</span>
                <div class="registration-status"></div>
                <span class="registration-name-surname">@doctor.FirstName @doctor.LastName</span>
                    <span class="registration-date">@doctor.RegistrationDate</span>
                    <a asp-controller="Admin" asp-action="RegistrationInfoPage" asp-route-id="@doctor.Id" class="registration-link">Λεπτομέρειες</a>

            </li>

            }


        </ul>


    </div>
</div>

<!-- Pagination Controls -->
<div aria-label="Page navigation example">
    <ul class="pagination">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a href="@Url.Action(action: "PendingRegistrationForms", controller: "Admin", new { term = Model.Term, page = Model.CurrentPage - 1, pageSize = Model.PageSize })" class="page-link">Previous</a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item">
                <a href="@Url.Action(action: "PendingRegistrationForms", controller: "Admin", new { term = Model.Term, page = i, pageSize = Model.PageSize })" class="page-link @(i == Model.CurrentPage ? "active" : "")">
                    @i
                </a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a href="@Url.Action(action: "PendingRegistrationForms", controller: "Admin", new { term = Model.Term, page = Model.CurrentPage + 1, pageSize = Model.PageSize })" class="page-link">Next</a>
            </li>
        }
    </ul>
</div>