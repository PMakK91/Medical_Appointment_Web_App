@model MedicalAppointmentWebApp.Models.ViewModels.PracticeSearchViewModel
@{
    ViewData["Title"] = "Εκκρεμείς Αιτήσεις Ιατρείων";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Εκκρεμείς Αιτήσεις</h1>
        <p class="subtitle mb-5">Αιτήσεις ιατρείων προς εξέταση</p>


        <form method="get" action="@Url.Action(action: "PendingPractices", controller: "Admin")" class="mx-auto mb-5 search-form">

            <input type="text" name="term" value="@Model.Term" aria-label="Αναζήτηση" class="form-control search-input " />


            <button type="submit" class="btn primary-btn btn-primary w-100 mt-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20 L16.5 16.5"></path>
                </svg>
                Αναζήτηση
            </button>

        </form>

        <ul class="admin-registrations-list list-unstyled mx-auto">

            @foreach (var practice in Model.Practices)
            {
                <li class="mb-3">
                    <div class="row">

                        <div class="col-8 fc-blue fs-18 fw-600 text-start">#@practice.Id.ToString().Substring(0, Math.Min(6, practice.Id.ToString().Length))</div>
                        <div class="col-4 d-flex justify-content-end"><div class="status-circle"></div></div>

                    </div>
                    <div class="row mt-4">

                        <div class="col-8 fc-black fs-16 fw-400 text-start">
                       
                             @practice.Doctor?.FirstName @practice.Doctor?.LastName
                           
                        </div>
                        <div class="col-4 fc-black fs-16 fw-400 text-end">

                            #@practice.DoctorId.ToString().Substring(0, Math.Min(6, practice.DoctorId.ToString().Length))
                        </div>

                      

                    </div>

                    <div class="row mt-3">

                        <div class="col-12 fc-black fs-16 fw-100 text-start"> @practice.FullAddress</div>


                    </div>

                    <div class="registration-separator"></div>

                   
                    <div class="row">
                        <div class="col-5 fs-16 fw-100 fc-grey text-start">@practice.RegistrationDate.ToString("dd-MM-yyyy")</div>
                        <div class="col-7 text-end">
                            <a class="fs-16 fw-100 fc-blue text-decoration-none" sp-controller="Admin" asp-action="PracticeInfoPage" asp-route-id="@practice.Id">Λεπτομέρειες</a>
                        </div>
                    </div>

                </li>

            }


        </ul>
        <!-- Pagination Controls -->
        <div aria-label="Page navigation">
            <ul class="pagination mx-auto mt-5 d-flex justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a href="@Url.Action(action: "PendingPractices", controller: "Admin", new { term = Model.Term, page = Model.CurrentPage - 1, pageSize = Model.PageSize })" class="page-link border-0 fc-black bg-transparent">🡠</a>
                    </li>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "PendingPractices", controller: "Admin", new { term = Model.Term, page = i, pageSize = Model.PageSize })" class="page-link border-0 @(i == Model.CurrentPage ? "active bg-blue" : "fc-black bg-transparent")">
                            @i
                        </a>
                    </li>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item fc-black border-0 bg-transparent">
                        <a href="@Url.Action(action: "PendingPractices", controller: "Admin", new { term = Model.Term, page = Model.CurrentPage + 1, pageSize = Model.PageSize })" class="page-link border-0 fc-black bg-transparent">🡢</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
