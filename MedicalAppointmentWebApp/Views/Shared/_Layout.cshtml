    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 bg-white">
        <div class=" text-center">
            <p class="fc-black fs-14 fw-100 mb-1"> &copy; 2026 - MedicalAppointmentWebApp</p>
            <a class="fc-blue fs-14 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Privacy">Απόρρητο</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
