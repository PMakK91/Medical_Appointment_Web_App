                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action(action: "Index", controller: "Doctor", new { term = "", page = 1, pageSize = 10 })" class="nav-link text-dark">Doctors</a>
                        </li>
                        -->
                        @if (User.Identity != null && (User.IsInRole("Doctor") || User.IsInRole("Patient")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Appointment" asp-action="MyAppointments">Τα Ραντεβού Μου</a>
                            </li>
                        }

                        @if (User.Identity != null && User.IsInRole("Doctor"))
                        {
                            @* <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Practice" asp-action="MyPractices">Τα Γραφεία Μου</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Practice" asp-action="Enroll">Εγγραφή Γραφείου</a>
                            </li> *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctor" asp-action="EditProfile">Το Προφίλ Μου</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@Url.Action("Calendar", "Doctor")">Ημερολόγιο</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@Url.Action("MyPractices", "Practice")">Ιατρεία</a>
                            </li>
                        }

                        @if (User.Identity != null && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@Url.Action(action: "PendingRegistrationForms", controller: "Admin", new { term = "", page = 1, pageSize = 10 })">Αιτήσεις Ιατρών</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@Url.Action(action: "PendingPractices", controller: "Admin", new { term = "", page = 1, pageSize = 10 })">Αιτήσεις Γραφείων</a>
                            </li>
                        }

                       
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form method="post" asp-action="Logout" asp-controller="Auth">
                                    <button class="nav-link text-dark" type="submit">Αποσύνδεση</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Auth" asp-action="Login">Σύνδεση</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Auth" asp-action="Register">Εγγραφή</a>
                            </li>
                        }
                    </ul>
