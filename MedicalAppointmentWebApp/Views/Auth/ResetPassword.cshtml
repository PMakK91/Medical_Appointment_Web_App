@model MedicalAppointmentWebApp.Models.ViewModels.NewPasswordRequestViewModel
@{
    ViewData["Title"] = "Επαναφορά κωδικού";
    Layout = "_Layout";
}
<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Επαναφορά κωδικού</h1>

        <form method="post" asp-controller="Auth" asp-action="ResetPassword" class="login-form">

            <div class="">
                <label class="form-label login-label" for="password">Κωδικός:</label>

                <input asp-for="Token" type="hidden" />

                <div class="password-wrapper">
                    <input type="password"
                           asp-for="Password"
                           class="form-control login-input"
                           aria-label="Password"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">

                        <svg class="eye-icon eye-open"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor" stroke-width="2" />
                            <circle cx="12" cy="12" r="3"
                                    stroke="currentColor" stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor" stroke-width="2" />
                        </svg>

                    </button>
                </div>

            </div>

            <div class="">
                <label class="form-label login-label" for="confirm-password">Επιβεβαίωση Κωδικός:</label>


                <div class="password-wrapper">
                    <input type="password"
                           asp-for="ConfirmPassword"
                           class="form-control login-input"
                           aria-label="Confirm Password"
                           autocomplete="Confirm Password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">

                        <svg class="eye-icon eye-open"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor" stroke-width="2" />
                            <circle cx="12" cy="12" r="3"
                                    stroke="currentColor" stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor" stroke-width="2" />
                        </svg>

                    </button>
                </div>

            </div>

            <button type="submit" class="mt-3 btn primary-btn w-100 login-btn">
                Αλλαγή Κωδικού
            </button>

            <!-- form errors -->
            <div class="form-error mt-3 d-none">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
            <div class="form-success mt-3 d-none">
            @Html.ValidationSummary(true, "", new { @class = "text-success" })
            </div>
        </form>
    </div>
</div>