@using MedicalAppointmentWebApp.Data.Enums
@model MedicalAppointmentWebApp.Models.Security.DoctorRegisterFormRequest
@{
}

<!DOCTYPE html>
<html>
<head>

</head>
<body>

    @using (Html.BeginForm("DoctorRegister", "Auth", FormMethod.Post))
    {
        <div class="container">
           <h1>Register</h1>
            <p>Please fill in this form to create an account.</p>
            <hr>

            <label for="email"><b>Email*</b></label>
            <input type="text" asp-for="Email" placeholder="Enter Email" id="email" required>
            <br>
            <label for="psw"><b>Password*</b></label>
            <input type="password" asp-for="Password" placeholder="Enter Password" id="psw" required>
            <br>
            <label for="psw-confirm"><b>Confirm Password*</b></label>
            <input type="password" asp-for="ConfirmPassword" placeholder="Confirm Password" id="psw-confirm" required>
            <br>
            <label for="amka"><b>AMKA*</b></label>
            <input type="text" asp-for="Amka" placeholder="Enter AMKA" id="amka" required>
            <br>
            <label for="specialty"><b>Specialty*</b></label>
            <select asp-for="Specialty" asp-items="Html.GetEnumSelectList<Specialty>()" required>
                <option value="">-- Select specialty --</option>
            </select>
            <br>
            <label for="name"><b>Name</b></label>
            <input type="text" asp-for="Name" placeholder="Enter Name" id="name">
            <br>
            <label for="last-name"><b>Lastname</b></label>
            <input type="text" asp-for="LastName" placeholder="Enter Lastname" id="last-name">
            <br>
            <label for="phone"><b>Phone</b></label>
            <input type="text" asp-for="Phone" placeholder="Enter Phone" id="phone">
            <br>
            <label for="gender"><b>Gender</b></label>
            <select asp-for="Gender" id="gender">
                <option value="0">Male</option>
                <option value="1">Female</option>
                <option value="2">Other</option>
            </select>
            <br>
            <label for="birth-date"><b>Birth Date</b></label>
            <input type="date" asp-for="BirthDate" id="birth-date">

            <hr>
            <button type="submit" class="registerbtn">Register</button>
        </div>

        <div class="container signin">
            <p>Already have an account? <a href="#">Sign in</a>.</p>
        </div>
    }

</body>
</html>