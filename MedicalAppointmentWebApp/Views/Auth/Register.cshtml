@using MedicalAppointmentWebApp.Data.Enums
@model MedicalAppointmentWebApp.Models.Security.RegisterRequest
@{
    ViewData["Title"] = "Εγγραφή";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center mb-5 mt-4">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Εγγραφή</h1>
        <p class="subtitle mb-5"></p>

        <div class="register-tabs" role="tablist" aria-label="Επιλογή ρόλου">
            <button type="button" class="register-tab active" role="tab" aria-selected="true">
                Ασθενής
            </button>
            <button type="button" class="register-tab" role="tab" aria-selected="false">
                Ιατρός
            </button>
        </div>

        <!-- ===================== PATIENT FORM ===================== -->
        <form asp-controller="Auth" asp-action="PatientRegister" id="register-form-patient" method="post" class="register-form">
            <div class="mb-3">
                <label class="form-label register-label" for="firstNamePatient">Όνομα:</label>
                <input asp-for="FirstName" type="text"
                       class="form-control register-input" aria-label="Όνομα"
                       autocomplete="given-name" required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label" for="lastNamePatient">Επώνυμο:</label>
                <input asp-for="LastName" type="text"
                       class="form-control register-input" aria-label="Επώνυμο"
                       autocomplete="family-name" required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label" for="phonePatient">Κινητό Τηλέφωνο:</label>
                <input asp-for="Phone" type="tel"
                       class="form-control register-input" aria-label="Κινητό Τηλέφωνο"
                       autocomplete="tel" inputmode="tel" pattern="[0-9]{10}" minlength="10" maxlength="10"
                       title="Το τηλέφωνο απαιτείται να έχει 10 ψηφία"
                       required />
            </div>
            <div class="mb-3">
                <label class="form-label register-label" for="amkaPatient">ΑΜΚΑ:</label>
                <input asp-for="Amka" type="text"
                       class="form-control register-input" aria-label="Αμκα"
                       pattern="[0-9]{11}" minlength="11" maxlength="11" inputmode="numeric"
                       title="Ο ΑΜΚΑ πρέπει να αποτελείται από 11 ψηφία"
                      required />
            </div>


            <div class="mb-3">
                <label class="form-label register-label" for="emailPatient">Email:</label>
                <input asp-for="Email" type="email"
                       class="form-control register-input"
                       autocomplete="email"
                       maxlength="254"
                       pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$"
                       title="Εισάγετε έγκυρο email (π.χ. name@domain.com)."
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label">Κωδικός:</label>

                <div class="password-wrapper">
                    <input type="password"
                           asp-for="Password"
                           class="form-control register-input"
                           aria-label="Password"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">

                        <svg class="eye-icon eye-open"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor" stroke-width="2" />
                            <circle cx="12" cy="12" r="3"
                                    stroke="currentColor" stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor" stroke-width="2" />
                        </svg>

                    </button>
                </div>
            </div>


            <button type="submit" class="btn primary-btn w-100">
                Εγγραφή ως ασθενής
            </button>

            <div class="form-error mt-3 d-none" id="patientFormError"></div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </form>

        <!-- ===================== DOCTOR FORM ===================== -->
        <form asp-controller="Auth" asp-action="DoctorRegister" id="register-form-doctor" method="post" class="register-form d-none">
            <div class="mb-3">
                <label class="form-label register-label" for="firstNameDoctor">Όνομα:</label>
                <input asp-for="FirstName" type="text"
                       class="form-control register-input" aria-label="Όνομα"
                       autocomplete="given-name" required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label" for="lastNameDoctor">Επώνυμο:</label>
                <input asp-for="LastName" type="text"
                       class="form-control register-input" aria-label="Επώνυμο"
                       autocomplete="family-name" required />
            </div>

            <!-- Specialization searchable dropdown (search inside dropdown) -->
            <div class="mb-3">
                <label class="form-label register-label">Ειδικότητα:</label>

                <div class="dropdown w-100" id="specializationDropdownWrap">
                    <button class="btn register-select dropdown-toggle w-100"
                            type="button"
                            id="specializationDropdownBtn"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <span id="specializationSelectedText" aria-hidden="true"></span>
                    </button>

                    <div class="dropdown-menu w-100 p-2" aria-labelledby="specializationDropdownBtn" id="specializationMenu">
                        <div class="px-1 pb-2">
                            <input type="text"
                                   class="form-control register-input"
                                   id="specializationSearch"
                                   placeholder="Αναζήτηση ειδικότητας..."
                                   autocomplete="off" />
                        </div>

                        <ul class="list-unstyled mb-0" id="specializationList">
                            @foreach (var item in Html.GetEnumSelectList<Specialty>())
                            {
                                <li>
                                    <button class="dropdown-item"
                                            type="button"
                                            data-value="@( (int)Enum.Parse(typeof(Specialty), item.Value) )">
                                        @item.Text
                                    </button>
                                </li>
                            }
                        </ul>

                        <div class="text-muted px-2 py-2 d-none" id="specializationNoResults">
                            Δεν βρέθηκαν αποτελέσματα
                        </div>
                    </div>

                    <input asp-for="Specialty" type="hidden" id="Specialization" required />
                </div>

                <div class="form-error mt-2 d-none" id="specializationError"></div>
            </div>

            <div class="mb-3">
                <label class="form-label register-label" for="licenseNumberDoctor">Αριθμός Ιατρικού Μητρώου:</label>
                <input asp-for="LicenseNumber"
                       type="text"
                       class="form-control register-input"
                       aria-label="Αριθμός Ιατρικού Μητρώου"
                       minlength="11"
                       maxlength="11"
                       pattern="[0-9]{11}"
                       inputmode="numeric"
                       title="Ο αριθμός μητρώου πρέπει να περιέχει 11 ψηφία."
                       required />
            </div>
            <div class="mb-3">
                <label class="form-label register-label" for="amkaDoctor">ΑΜΚΑ:</label>
                <input asp-for="Amka" type="text"
                       class="form-control register-input" aria-label="Αμκα"
                       pattern="[0-9]{11}" minlength="11" maxlength="11" inputmode="numeric"
                       title="Ο ΑΜΚΑ πρέπει να αποτελείται από 11 ψηφία"
                       required />
            </div>
            <div class="mb-3">
                <label class="form-label register-label mb-0" for="phoneDoctor">Κινητό Τηλέφωνο:</label>
                <p class="register-label-description mt-0">
                    Θα παραμείνει κρυφό. Χρησιμοποιείται μόνο για τον λογαριασμό σας
                </p>
                <input asp-for="Phone"
                       type="tel"
                       class="form-control register-input"
                       aria-label="Κινητό Τηλέφωνο"
                       autocomplete="tel"
                       inputmode="numeric"
                       pattern="[0-9]{10}"
                       minlength="10"
                       maxlength="10"
                       title="Το κινητό τηλέφωνο πρέπει να περιέχει ακριβώς 10 ψηφία."
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label" for="emailDoctor">Email:</label>
                <input asp-for="Email" type="email"
                       class="form-control register-input"
                       autocomplete="email"
                       maxlength="254"
                       pattern="^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$"
                       title="Εισάγετε έγκυρο email (π.χ. name@domain.com)."
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label register-label">Κωδικός:</label>

                <div class="password-wrapper">
                    <input asp-for="Password"
                           type="password"
                           class="form-control register-input"
                           aria-label="Password"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">

                        <svg class="eye-icon eye-open"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor" stroke-width="2" />
                            <circle cx="12" cy="12" r="3"
                                    stroke="currentColor" stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor" stroke-width="2" />
                        </svg>

                    </button>
                </div>
            </div>


            <button type="submit" class="btn w-100 primary-btn">
                Αίτηση εγγραφής ως ιατρός
            </button>

            <p class="register-info mt-3 mb-5">
                Θα ενημερωθείτε για την εξέληξη του αιτήματος μέσω email μόλις ελεγχθεί από το σύστημα
            </p>

            <div class="form-error mt-3">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            </div>
        </form>

        <div class="register-footer mt-5">
            <p class="mb-1">Έχετε ήδη λογαριασμό;</p>
            <a asp-controller="Auth" asp-action="Login" class="register-link">Κάντε σύνδεση</a>
        </div>
    </div>
</div>