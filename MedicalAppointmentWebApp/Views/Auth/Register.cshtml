@model MedicalAppointmentWebApp.Models.Security.RegisterRequest
@{
}

@using (Html.BeginForm("PatientRegister", "Auth", FormMethod.Post))
{
    <div class="container">
        <h1>Register</h1>

        <hr>

        <div class="form-group">
            <label for="email"><b>Email*</b></label>
            <input type="text" asp-for="Email" class="form-control" placeholder="Enter Email" id="email" required>
        </div>

        <div class="form-group">
            <label for="psw"><b>Password*</b></label>
            <input type="password" asp-for="Password" class="form-control" placeholder="Enter Password" id="psw" required>
        </div>

        <div class="form-group">
            <label for="psw-confirm"><b>Confirm Password*</b></label>
            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" id="psw-confirm" required>
        </div>

        <div class="form-group">
            <label for="amka"><b>AMKA*</b></label>
            <input type="text" asp-for="Amka" class="form-control" placeholder="Enter AMKA" id="amka" required>
        </div>

        <div class="form-group">
            <label for="name"><b>Name</b></label>
            <input type="text" asp-for="Name" class="form-control" placeholder="Enter Name" id="name">
        </div>

        <div class="form-group">
            <label for="last-name"><b>Lastname</b></label>
            <input type="text" asp-for="LastName" class="form-control" placeholder="Enter Lastname" id="last-name">
        </div>

        <div class="form-group">
            <label for="phone"><b>Phone</b></label>
            <input type="text" asp-for="Phone" class="form-control" placeholder="Enter Phone" id="phone">
        </div>

        <div class="form-group">
            <label for="gender"><b>Gender</b></label>
            <select asp-for="Gender" class="form-control" id="gender">
                <option value="0">Male</option>
                <option value="1">Female</option>
                <option value="2">Other</option>
            </select>
        </div>

        <div class="form-group">
            <label for="birth-date"><b>Birth Date</b></label>
            <input type="date" asp-for="BirthDate" class="form-control" id="birth-date">
        </div>

        <hr>
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>

    <div class="container signin">
        <p>Already have an account? <a href="#">Sign in</a>.</p>
    </div>
}
