@model MedicalAppointmentWebApp.Models.Security.AuthRequest
@{
    ViewData["Title"] = "Σύνδεση";
    Layout = "_Layout";
}
<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Σύνδεση</h1>
        <p class="subtitle mb-5">Συμπληρώστε τα στοιχεία σας για να <br /> εισέλθετε στον λογαριασμό σας</p>

      


        <form method="post" asp-controller="Auth" asp-action="Login" class="login-form">
            <div class="mb-3">
                <label class="form-label login-label" for="email">Email:</label>
                <input id="email" type="email" asp-for="Email" class="form-control login-input" aria-label="Email" autocomplete="email" required />
            </div>

            <div class="">
                <label class="form-label login-label" for="password">Κωδικός:</label>


                <div class="password-wrapper">
                    <input type="password"
                           asp-for="Password"
                           class="form-control login-input"
                           aria-label="Password"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Εμφάνιση / απόκρυψη κωδικού">

                        <svg class="eye-icon eye-open"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12Z"
                                  stroke="currentColor" stroke-width="2" />
                            <circle cx="12" cy="12" r="3"
                                    stroke="currentColor" stroke-width="2" />
                        </svg>

                        <svg class="eye-icon eye-closed d-none"
                             width="18" height="18" viewBox="0 0 24 24" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 3l18 18"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4"
                                  stroke="currentColor" stroke-width="2" />
                            <path d="M1 12s4-7 11-7c2 0 3.8.5 5.4 1.4M23 12s-4 7-11 7c-2 0-3.8-.5-5.4-1.4"
                                  stroke="currentColor" stroke-width="2" />
                        </svg>

                    </button>
                </div>

            </div>

            <a class="px-3 d-block mt-2 mb-4 fc-grey fs-14 fw-100 text-decoration-none text-start" asp-area="" asp-controller="Auth" asp-action="ForgotPassword" aria-label="forgot-password">Ξέχασα τον κωδικό μου</a>
    
            <button type="submit" class="btn primary-btn w-100 login-btn">
                Σύνδεση
            </button>

            <!-- form errors -->
            <div class="form-error mt-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            </div>

        </form>



        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mt-4 alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mt-4 alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="login-separator"><span>ή</span></div>


        <a asp-controller="Auth" asp-action="GoogleLogin"  class="mt-4 btn google-auth">
            <svg height="1em" style="flex:none;line-height:1" viewBox="0 0 24 24" width="1em" xmlns="http://www.w3.org/2000/svg"><title>Google</title><path d="M23 12.245c0-.905-.075-1.565-.236-2.25h-10.54v4.083h6.186c-.124 1.014-.797 2.542-2.294 3.569l-.021.136 3.332 2.53.23.022C21.779 18.417 23 15.593 23 12.245z" fill="#4285F4"></path><path d="M12.225 23c3.03 0 5.574-.978 7.433-2.665l-3.542-2.688c-.948.648-2.22 1.1-3.891 1.1a6.745 6.745 0 01-6.386-4.572l-.132.011-3.465 2.628-.045.124C4.043 20.531 7.835 23 12.225 23z" fill="#34A853"></path><path d="M5.84 14.175A6.65 6.65 0 015.463 12c0-.758.138-1.491.361-2.175l-.006-.147-3.508-2.67-.115.054A10.831 10.831 0 001 12c0 1.772.436 3.447 1.197 4.938l3.642-2.763z" fill="#FBBC05"></path><path d="M12.225 5.253c2.108 0 3.529.892 4.34 1.638l3.167-3.031C17.787 2.088 15.255 1 12.225 1 7.834 1 4.043 3.469 2.197 7.062l3.63 2.763a6.77 6.77 0 016.398-4.572z" fill="#EB4335"></path></svg>
            Σύνδεση με Google
        </a>

        <div class="login-footer mt-5">
            <p class="mb-1">Πρώτη φορά στο app;</p>
            <a asp-controller="Auth" asp-action="Register" class="login-link">Κάντε εγγραφή</a>
        </div>
    </div>
</div>