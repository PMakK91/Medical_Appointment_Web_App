@using MedicalAppointmentWebApp.Data.Enums
@model IEnumerable<Appointment>

@{
    ViewData["Title"] = "Τα Ραντεβού μου";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">
        <h1 class="title mb-2">Τα Ραντεβού μου</h1>
        <p class="subtitle mb-5"></p>

@if (Model.Any())
{



     <ul class="my-appointments-list list-unstyled mx-auto">

               
    @foreach (var ap in Model)
    {
        

                    <li class="mb-3">
                        <div class="row">
                            <div class="col-8 text-start">
                                <div class="d-inline fc-blue fs-18 fw-600 ">@ap.Time.ToString("dd/MM/yyyy")</div>
                                <div class="d-inline fc-blue fs-18 fw-200 ms-2">@ap.Time.ToString("HH:mm")</div>
                            </div>
                            <div class="col-4 d-flex justify-content-end">
                                <div class="status-tag
                @(ap.Status == AppointmentStatus.Scheduled ? "tag-green" :
                                               ap.Status == AppointmentStatus.Completed ? "tag-blue" :
                                               ap.Status == AppointmentStatus.Canceled ? "tag-red" :
                                               "tag-gray")">

                                    @(ap.Status == AppointmentStatus.Scheduled ? "Προγραμματισμένο" :
                                                                ap.Status == AppointmentStatus.Completed ? "Ολοκληρωμένο" :
                                                                ap.Status == AppointmentStatus.Canceled ? "Ακυρωμένο" :
                                                                "Απών")
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-2 pe-0">

                                @if (ap.Doctor.ImageUrl is null)
                                {
                                    <img class="doctor-image" id="previewImage"
                                         src="/Images/placeholder-doctor-image.png"
                                         alt="Profile">
                                }
                                else
                                {
                                    <img class="doctor-image" id="previewImage" src="/Images/@ap.Doctor.ImageUrl" alt="Profile">
                                }


                                </div>

                                <div class="col-10">
                            <div class=" fc-black fs-16 fw-400 text-start"> @ap.Doctor?.FirstName @ap.Doctor?.LastName</div>
                          
                                <div class=" fc-black fs-16 fw-100 text-start">@Html.DisplayFor(modelItem => ap.Doctor.Specialty)</div>
                           


                            </div>
                        </div>

                        <div class="row mt-4">

                        <div class="col-12 fc-black fs-16 fw-100 text-start">       <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                                <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10" />
                                <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />
                            </svg> @ap.Practice.FullAddress</div>
                            
                  

                        </div>

                        <div class="registration-separator"></div>


                        <div class="row justify-content-end">
        @if (ap.Status == AppointmentStatus.Scheduled)
                            {

                                <div class="col-sm-6  col-xs-12 text-start p-1">
                                    <form asp-controller="Appointment"
                                    asp-action="CancelAppointment"
                                    asp-route-id="@ap.Id"
                                    method="post">

                                        <button type="submit" class="w-100 btn primary-btn delete mx-auto">
                                            <svg style="    margin-right: 5px;" fill="currentColor" height="10px" width="10px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                                            viewBox="0 0 460.775 460.775" xml:space="preserve">
                                                <path d="M285.08,230.397L456.218,59.27c6.076-6.077,6.076-15.911,0-21.986L423.511,4.565c-2.913-2.911-6.866-4.55-10.992-4.55
 c-4.127,0-8.08,1.639-10.993,4.55l-171.138,171.14L59.25,4.565c-2.913-2.911-6.866-4.55-10.993-4.55
 c-4.126,0-8.08,1.639-10.992,4.55L4.558,37.284c-6.077,6.075-6.077,15.909,0,21.986l171.138,171.128L4.575,401.505
 c-6.074,6.077-6.074,15.911,0,21.986l32.709,32.719c2.911,2.911,6.865,4.55,10.992,4.55c4.127,0,8.08-1.639,10.994-4.55
 l171.117-171.12l171.118,171.12c2.913,2.911,6.866,4.55,10.993,4.55c4.128,0,8.081-1.639,10.992-4.55l32.709-32.719
 c6.074-6.075,6.074-15.909,0-21.986L285.08,230.397z" />
                                            </svg>
                                            Ακύρωση
                                        </button>

                                    </form>
                                </div>
                            }


                            <div class="col-sm-6 col-xs-12 text-end p-1">
                                <a class=" btn primary-btn " asp-controller="Appointment" asp-action="Index" asp-route-id="@ap.Id">Λεπτομέρειες</a>
                            </div>
                        </div>

                    </li>

            }
            </ul>
}
else
{

            <p class="fw-100 fc-grey mb-1">Δεν βρέθηκαν ραντεβού</p>

            
        }

    </div>
</div>