@model IEnumerable<Appointment>

@{
    ViewData["Title"] = "Τα Ραντεβού μου";
    Layout = "_Layout";
}

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Practice Id</th>
                <th scope="col">Doctor Id</th>
                <th scope="col">Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ap in Model)
            {
                <tr>
                    <td>@ap.PracticeId</td>
                    <td>@ap.DoctorId</td>
                    <td>@ap.Time</td>
                </tr>

            }
        </tbody>
    </table>
}
else
{
    <h2>Δεν βρέθηκαν ραντεβού</h2>
    <a asp-controller="Doctor" asp-action="Index">Κλείστε ραντεβού τώρα!</a>
}