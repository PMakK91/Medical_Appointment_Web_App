@model MedicalAppointmentWebApp.Models.ViewModels.WeekScheduleViewModel

<div class="practice-schedule position-relative" 
     data-practice-id="@Model.Practice.Id"
     data-week-start="@Model.WeekStartDate.ToString("yyyy-MM-dd")">

    <div class="schedule-content">
        <div class="text-center mb-2 schedule-controls">
            <button class="btn btn-primary prev-week">Previous</button>
            <span class="week-label">
                @Model.WeekStartDate.ToShortDateString() - @Model.WeekStartDate.AddDays(6).ToShortDateString()
            </span>
            <button class="btn btn-primary next-week">Next</button>
        </div>

        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>Time</th>
                    @for (int d = 0; d < 7; d++)
                    {
                        <th>@Model.WeekStartDate.AddDays(d).ToString("ddd dd")</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    var dailySlots = Model.Slots
                        .GroupBy(s => s.Start.TimeOfDay)
                        .OrderBy(g => g.Key);
                    var days = Enumerable.Range(0, 7)
                                         .Select(i => Model.WeekStartDate.AddDays(i))
                                         .ToList();
                }

                @foreach (var timeGroup in dailySlots)
                {
                    <tr>
                        <td>@DateTime.Today.Add(timeGroup.Key).ToString("HH:mm")</td>
                        @foreach (var day in days)
                        {
                            var slot = Model.Slots.FirstOrDefault(s =>
                                s.Start.Date == day.Date &&
                                s.Start.TimeOfDay == timeGroup.Key);

                            <td class="slot @(slot?.IsBooked == true ? "bg-danger" : "bg-success")"
                                data-time="@slot?.Start.ToString("o")">
                                @(slot?.IsBooked == true ? "Booked" : "Available")
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Loading spinner -->
    <div class="schedule-loading" style="display:none;position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(255,255,255,0.7);z-index:10;text-align:center;">
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Loading...
        </div>
    </div>

</div>

<script>
$(function () {

    function parseLocalDate(dateString) {
        var parts = dateString.split('-');
        return new Date(
            parseInt(parts[0]),
            parseInt(parts[1]) - 1,
            parseInt(parts[2])
        );
    }

    function formatLocalDate(date) {
        var year = date.getFullYear();
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function startOfWeek(date) {
        var d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        var day = d.getDay();
        var diff = day === 0 ? -6 : 1 - day; // Sunday fix
        d.setDate(d.getDate() + diff);
        d.setHours(0, 0, 0, 0);
        return d;
    }

    function showLoading(container, show) {
        container.find('.schedule-loading').toggle(show);
    }



    function updatePrevButton(container) {

        var todayMonday = startOfWeek(new Date());

        var weekStartStr = container.data('week-start');
        var currentWeek = startOfWeek(parseLocalDate(weekStartStr));

        var prevBtn = container.find('.prev-week');

        if (currentWeek <= todayMonday) {
            prevBtn.hide();
        } else {
            prevBtn.show();
        }
    }

    function loadWeek(container, date) {

        var practiceId = container.data('practice-id');
        var formattedDate = formatLocalDate(date);

        showLoading(container, true);

        $.ajax({
            url: '@Url.Action("AvailableTimeSlots", "Practice")',
            type: 'GET',
            data: {
                Id: practiceId,
                weekStart: formattedDate
            },
            success: function (result) {

                container.find('.schedule-content').html(result);

                container.data('week-start', formattedDate);

                updatePrevButton(container);
            },
            complete: function () {
                showLoading(container, false);
            }
        });
    }



    $(document).on('click', '.practice-schedule .prev-week', function () {

        var container = $(this).closest('.practice-schedule');
        var currentWeek = parseLocalDate(container.data('week-start'));

        currentWeek.setDate(currentWeek.getDate() - 7);

        loadWeek(container, currentWeek);
    });

    $(document).on('click', '.practice-schedule .next-week', function () {

        var container = $(this).closest('.practice-schedule');
        var currentWeek = parseLocalDate(container.data('week-start'));

        currentWeek.setDate(currentWeek.getDate() + 7);

        loadWeek(container, currentWeek);
    });



    $('.practice-schedule').each(function () {
        updatePrevButton($(this));
    });

});
</script>
