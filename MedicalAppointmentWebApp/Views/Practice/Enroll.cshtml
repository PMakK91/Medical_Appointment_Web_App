@model MedicalAppointmentWebApp.Models.ViewModels.PracticeEnrollRequest

@{
    ViewData["Title"] = "Προσθήκη Ιατρείου";
    Layout = "_Layout";
}

<!--- GOOGLE MAPS API ----->
<script>
    async function init() {
        await google.maps.importLibrary("places");

        // MUST match the element id in the HTML
        const widget = document.getElementById("officeAddress");
        if (!widget) return;

            widget.addEventListener("gmp-select", async (event) => {
        const place = event.placePrediction.toPlace();

        await place.fetchFields({
            fields: ["id", "formattedAddress", "location", "addressComponents"]
        });

        const lat = place.location?.lat?.() ?? "";
        const lng = place.location?.lng?.() ?? "";

        let city = "";

        place.addressComponents?.forEach(component => {
            if (component.types.includes("locality")) {
                city = component.longText;
            }
        });

        document.getElementById("PlaceId").value = place.id || "";
        document.getElementById("FullAddress").value = place.formattedAddress || "";
         document.getElementById("Lat").value = lat.toString().replace(".", ",");
    document.getElementById("Lon").value = lng.toString().replace(".", ",");
    });
    }

    window.init = init;
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAsMPBVJ_u5YLmRIrIti_U0YRp3UhOi8-Q&libraries=places&v=beta&callback=init&loading=async"
        async
        defer>
</script>
<!--- /GOOGLE MAPS API ----->

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">

        <h1 class="title mb-2">Προσθήκη Ιατρείου</h1>
        <p class="subtitle mb-5"></p>

        <form id="officeForm" class="office-form" method="post">



            <div class="mb-3">
                <label class="office-label">Ονομασία</label>
                <input asp-for="Name" class="form-control office-input" required />

            </div>

            <div class="mb-3">
                <label class="office-label">Διάρκεια Ραντεβού (λεπτά)</label>
                <input class="form-control office-input" asp-for="Duration" type="text"
                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,2)"
                       required />

            </div>

            <div class="mb-3">
                <label class="office-label">Τηλέφωνο</label>
                <input class="form-control office-input" asp-for="Phone" type="text"
                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)"
                       required />

            </div>

            <div class="mb-3">
                <label class="office-label" for="officeAddress">Διεύθυνση</label>


                <gmp-place-autocomplete id="officeAddress"></gmp-place-autocomplete>


                <input type="hidden" asp-for="PlaceId" id="PlaceId" />
                <input type="hidden" asp-for="FullAddress" id="FullAddress" />
                <input type="hidden" asp-for="Lat" id="Lat" />
                <input type="hidden" asp-for="Lon" id="Lon" />
