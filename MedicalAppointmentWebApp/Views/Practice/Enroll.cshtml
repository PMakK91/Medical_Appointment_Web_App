@model MedicalAppointmentWebApp.Models.ViewModels.PracticeEnrollRequest

@{
    ViewData["Title"] = "Προσθήκη Ιατρείου";
    Layout = "_Layout";
}

<div class="wrapper d-flex align-items-center">
    <div class="mx-auto w-100">

        <h1 class="title mb-2">Προσθήκη Ιατρείου</h1>
        <p class="subtitle mb-5"></p>

        <form id="officeForm" class="office-form" method="post">

            <div class="mb-3">
                <label class="office-label" for="officeAddress">Διεύθυνση</label>


                <div class="address-autocomplete" id="address-autocomplete">
                    <div class="input-wrap">
                        <div class="pin-icon" aria-hidden="true">
                            <svg class="position-absolute top-50 start-0 translate-middle-y ms-3" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="pointer-events: none;">
                                <path fill="#757575" fill-rule="evenodd" clip-rule="evenodd" d="M12 21.75L11.3 21.05C7.5 17.25 4 13.8 4 10.2C4 5.67 7.58 2 12 2C16.42 2 20 5.67 20 10.2C20 13.8 16.5 17.25 12.7 21.05L12 21.75ZM12 4C8.69 4 6 6.78 6 10.2C6 13.1 9 16.15 12 19.25C15 16.15 18 13.1 18 10.2C18 6.78 15.31 4 12 4ZM12 13C13.66 13 15 11.66 15 10C15 8.34 13.66 7 12 7C10.34 7 9 8.34 9 10C9 11.66 10.34 13 12 13ZM12 11C12.55 11 13 10.55 13 10C13 9.45 12.55 9 12 9C11.45 9 11 9.45 11 10C11 10.55 11.45 11 12 11Z" />
                            </svg>
                        </div>
                        <input id="officeAddress"
                               type="text"
                               placeholder="Τοποθεσία"
                               autocomplete="off" />
                    </div>

                    <div id="officeSuggestions" class="suggestions" hidden></div>
                </div>



                <input type="hidden" asp-for="PlaceId" id="PlaceId" />
                <input type="hidden" asp-for="FullAddress" id="FullAddress" />
                <input type="hidden" asp-for="Lat" id="Lat" />
                <input type="hidden" asp-for="Lon" id="Lon" />
            </div>

            <div class="mb-3">
                <label class="office-label">Διάρκεια Ραντεβού (λεπτά)</label>
                <input class="form-control office-input" asp-for="Duration" type="text"
                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,2)"
                       required />

            </div>

            <div class="mb-3">
                <label class="office-label">Τηλέφωνο</label>
                <input class="form-control office-input" asp-for="Phone" type="text"
                       oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)"
                       required />

            </div>

          

            <h3 class="fs-16 fw-400 fc-black mt-5">Ώρες Λειτουργίας</h3>

            <div class="office-hours">

                <div class="day-div">
                    <div class="day-name">Δευτέρα</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="MondayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="MondayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Τρίτη</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="TuesdayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="TuesdayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Τετάρτη</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="WednesdayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="WednesdayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Πέμπτη</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="ThursdayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="ThursdayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Παρασκευή</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="FridayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="FridayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Σάββατο</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="SaturdayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="SaturdayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

                <div class="day-div">
                    <div class="day-name">Κυριακή</div>
                    <div class="state">
                        <button type="button" class="toggle off" data-act="toggle"></button>
                        <div class="status-text">Κλειστά</div>
                    </div>
                    <div class="ranges">
                        <div class="range">
                            <select asp-for="SundayStart" class="daySelect"></select>
                        </div>
                        -
                        <div class="range">
                            <select asp-for="SundayEnd" class="daySelect"></select>
                        </div>
                    </div>
                </div>

            </div>

            <button type="submit" class="btn w-100 primary-btn mt-4 mb-5">
                Αποθήκευση
            </button>

        </form>
    </div>
</div>